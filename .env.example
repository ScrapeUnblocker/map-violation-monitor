# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# In GitHub Actions set these as repository secrets instead.

# Your ScrapeUnblocker API key: https://scrapeunblocker.com/?utm_source=github&utm_medium=integration&utm_campaign=example-repos
SCRAPEUNBLOCKER_KEY=your_key_here

# Alerts (each one is used when set; alerts.to in config.yml picks which).
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Google Sheet: one row per finding. The sheet's URL (or just its id), and the service
# account key: paste the whole JSON on one line, or give the path of the .json file.
# Share the sheet with the service account's email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Email (the weekly report by default). Needs SMTP_HOST and EMAIL_TO (comma-separated).
# Port 587 uses STARTTLS, 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Only for tests against a local stand-in of the Sheets API. Leave empty.
GOOGLE_SHEETS_API_URL=
